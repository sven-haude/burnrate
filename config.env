# burnrate – configuration (read by macOS and Windows)
# Values may reference $HOME (on Windows this resolves to %USERPROFILE%).

# Refresh interval in seconds (min. 30; polling more often gets you HTTP 429)
CLAUDE_USAGE_REFRESH_SECONDS=120
# Time span in minutes for the burn rate (tokens/min)
CLAUDE_USAGE_BURN_MINUTES=30

# Claude: internal endpoint also used by /usage in Claude Code (undocumented)
CLAUDE_USAGE_URL=https://api.anthropic.com/api/oauth/usage
CLAUDE_USAGE_BETA_HEADER=oauth-2025-04-20
# macOS: Claude Code keeps its OAuth token in this keychain entry
CLAUDE_USAGE_KEYCHAIN_SERVICE="Claude Code-credentials"
# Windows/Linux: Claude Code keeps its OAuth token in this file
CLAUDE_CREDENTIALS_FILE="$HOME/.claude/.credentials.json"
# Local Claude Code session logs (real token counts)
CLAUDE_PROJECTS_DIR="$HOME/.claude/projects"

# Codex: endpoint behind /status in the Codex CLI, token from its auth.json
CODEX_USAGE_URL=https://chatgpt.com/backend-api/wham/usage
CODEX_AUTH_FILE="$HOME/.codex/auth.json"
CODEX_SESSIONS_DIR="$HOME/.codex/sessions"
